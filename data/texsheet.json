[{"topic":"search","card":"search-problem","title":"Defining a search problem","tex":[{"t":"\\text{Path cost} = \\sum_{i=1}^{k} \\text{cost}(s_{i-1}, a_i)","where":[["s_0","start state (Arad)"],["a_i","the i-th action (drive along a road)"],["\\text{cost}(s,a)","step cost of doing action a in state s (road length)"]]},{"t":"\\text{RESULT}(s, a) = s'","where":[["s'","the state you reach (transition model)"]]}]},{"topic":"search","card":"search-tree","title":"Frontier, tree search and graph search","tex":[{"t":"\\text{Frontier} = \\{\\text{generated nodes}\\} \\setminus \\{\\text{expanded nodes}\\}","where":[]}]},{"topic":"search","card":"search-bfs-dfs","title":"BFS vs DFS (uninformed search)","tex":[{"t":"\\text{BFS: time } O(b^d),\\; \\text{space } O(b^d) \\qquad \\text{DFS: time } O(b^m),\\; \\text{space } O(bm)","where":[["b","branching factor (max children per node)"],["d","depth of the shallowest solution"],["m","maximum depth of the tree"]]}]},{"topic":"search","card":"search-ucs","title":"Uniform-cost search (UCS)","tex":[{"t":"f(n) = g(n)","where":[["g(n)","exact cost of the path from the start to node n"]]},{"t":"g(\\text{Râmnicu Vâlcea}) = 140 + 80 = 220","where":[]}]},{"topic":"search","card":"search-gbfs","title":"Greedy best-first search","tex":[{"t":"f(n) = h(n)","where":[["h(n)","estimated cost from n to the goal (e.g. straight-line distance)"]]}]},{"topic":"search","card":"search-astar","title":"A* search","tex":[{"t":"f(n) = g(n) + h(n)","where":[["g(n)","path cost from the start to n"],["h(n)","estimated cost from n to the goal"],["f(n)","estimated cost of the cheapest solution through n"]]},{"t":"f(\\text{Sibiu}) = 140 + 253 = 393","where":[]}]},{"topic":"search","card":"search-heuristics","title":"Admissible vs consistent heuristics","tex":[{"t":"\\text{Admissible: } h(n) \\le h^*(n)","where":[["h^*(n)","the TRUE cheapest cost from n to the goal"]]},{"t":"\\text{Consistent: } h(n) \\le c(n, a, n') + h(n')","where":[["c(n,a,n')","cost of the step from n to its successor n′"]]}]},{"topic":"trees","card":"trees-entropy","title":"Entropy","tex":[{"t":"H(S) = -\\sum_{i} p_i \\log_2 p_i","where":[["p_i","fraction of examples in class i"]]},{"t":"B(q) = -\\big[q\\log_2 q + (1-q)\\log_2(1-q)\\big]","where":[["q","fraction of positive examples (two classes)"]]},{"t":"H([2+,4-]) = -\\tfrac13\\log_2\\tfrac13 - \\tfrac23\\log_2\\tfrac23 = 0.9183","where":[]}]},{"topic":"trees","card":"trees-ig","title":"Information gain (ID3)","tex":[{"t":"IG(A) = H(\\text{parent}) - \\sum_{v} \\frac{|S_v|}{|S|}\\, H(S_v)","where":[["S_v","examples with attribute value v (one branch)"],["|S_v|/|S|","the branch's share of the examples"]]},{"t":"IG(\\text{Patrons}) = 1 - \\left[\\tfrac{2}{12}\\cdot0 + \\tfrac{4}{12}\\cdot0 + \\tfrac{6}{12}\\cdot0.9183\\right] = 0.5409","where":[]}]},{"topic":"trees","card":"trees-gini","title":"Gini index and Gini reduction (CART)","tex":[{"t":"\\text{Gini}(S) = 1 - \\sum_{i} p_i^{\\,2}","where":[["p_i","fraction of examples in class i"]]},{"t":"\\text{binary: } \\text{Gini} = 1 - p^2 - (1-p)^2,\\quad \\max \\text{ at } p = 0.5:\\; 1 - 0.25 - 0.25 = 0.5","where":[]},{"t":"\\text{Weighted Gini} = \\sum_i \\frac{|S_i|}{|S|}\\,\\text{Gini}(S_i) \\qquad \\text{Reduction} = \\text{Gini}(\\text{parent}) - \\text{Weighted Gini}","where":[]},{"t":"\\text{Gini(Full } [2+,4-]) = 1 - \\left(\\tfrac13\\right)^2 - \\left(\\tfrac23\\right)^2 = \\tfrac49 = 0.4444","where":[]}]},{"topic":"ml","card":"ml-types","title":"Forms of learning & generalisation","tex":[{"t":"\\text{Data } (x_1,y_1),\\dots,(x_N,y_N) \\text{ with } y = f(x); \\text{ learn } h \\approx f","where":[["f","the true (unknown) function"],["h","the hypothesis (model) we learn"],["x_{N+1}","a new input; predict y = h(x)"]]}]},{"topic":"ml","card":"ml-classification-metrics","title":"Confusion matrix and classification metrics","tex":[{"t":"\\text{Accuracy} = \\frac{TP + TN}{TP + FP + FN + TN}","where":[]},{"t":"\\text{Precision} = \\frac{TP}{TP + FP} \\qquad \\text{Recall (TPR)} = \\frac{TP}{TP + FN}","where":[]},{"t":"F_1 = \\frac{2 \\cdot \\text{Precision} \\cdot \\text{Recall}}{\\text{Precision} + \\text{Recall}}","where":[]},{"t":"\\text{Specificity} = \\frac{TN}{TN + FP}, \\quad \\text{FPR} = 1 - \\text{Specificity}, \\quad \\text{Balanced acc.} = \\frac{TPR + TNR}{2}","where":[]}]},{"topic":"ml","card":"ml-regression-metrics","title":"Regression metrics","tex":[{"t":"\\text{MAE} = \\frac{1}{N}\\sum_{i=1}^{N} |y_i - \\hat y_i| \\qquad \\text{MSE} = \\frac{1}{N}\\sum_{i=1}^{N} (y_i - \\hat y_i)^2","where":[["y_i","true value"],["\\hat y_i","predicted value"],["N","number of examples"]]},{"t":"\\text{RMSE} = \\sqrt{\\frac{1}{N}\\sum_{i=1}^{N} (y_i - \\hat y_i)^2}","where":[]},{"t":"R^2 = 1 - \\frac{\\sum_i (y_i - \\hat y_i)^2}{\\sum_i (y_i - \\bar y)^2}","where":[["\\bar y","mean of the true values"]]},{"t":"\\text{MAPE} = \\frac{100\\%}{N}\\sum_{i=1}^{N} \\left|\\frac{y_i - \\hat y_i}{y_i}\\right|","where":[]}]},{"topic":"ml","card":"ml-workflow","title":"Workflow, k-fold CV and avoiding leakage","tex":[{"t":"\\text{CV score} = \\frac{1}{k}\\sum_{i=1}^{k} S_i","where":[["S_i","score on validation fold i"],["k","number of folds (5 in Lecture 4)"]]}]},{"topic":"ml","card":"ml-ensembles","title":"Ensembles: random forest and gradient boosting","tex":[{"t":"\\hat y_{\\text{RF}} = \\text{vote/average}(T_1(x),\\dots,T_B(x)) \\qquad \\hat y_{\\text{GB}} = F_0(x) + \\eta\\sum_{m=1}^{M} T_m(x)","where":[["T_m","the m-th tree"],["\\eta","learning rate (shrinkage)"]]}]},{"topic":"ml","card":"ml-gd","title":"Linear regression and gradient descent","tex":[{"t":"\\text{Loss}(h_w) = \\sum_j \\big(y_j - (w_1 x_j + w_0)\\big)^2","where":[]},{"t":"w_i \\leftarrow w_i - \\alpha \\frac{\\partial\\, \\text{Loss}}{\\partial w_i}","where":[["\\alpha","learning rate (step size)"]]},{"t":"w_0 \\leftarrow w_0 + \\alpha\\,(y - h_w(x)) \\qquad w_1 \\leftarrow w_1 + \\alpha\\,(y - h_w(x))\\,x","where":[]}]},{"topic":"ml","card":"ml-logistic","title":"Logistic regression and cross-entropy","tex":[{"t":"p = \\sigma(z) = \\frac{1}{1 + e^{-z}},\\quad z = \\mathbf w\\cdot\\mathbf x","where":[]},{"t":"L = -\\big[\\,y\\ln p + (1 - y)\\ln(1 - p)\\,\\big]","where":[["y","true label (0 or 1)"],["p","predicted P(y = 1)"]]},{"t":"\\frac{\\partial L}{\\partial w_j} = (p - y)\\,x_j","where":[]}]},{"topic":"ml","card":"ml-knn","title":"K-nearest neighbours","tex":[{"t":"d(\\mathbf x, \\mathbf q) = \\sqrt{\\sum_i (x_i - q_i)^2} \\qquad \\hat y = \\frac{1}{k}\\sum_{j \\in N_k(\\mathbf q)} y_j","where":[["\\mathbf q","query point"],["N_k(\\mathbf q)","the k nearest training points"]]}]},{"topic":"ml","card":"ml-svm","title":"Support vector machines","tex":[{"t":"\\mathbf w\\cdot\\mathbf x + b = 0, \\qquad f(\\mathbf x) = \\operatorname{sign}(\\mathbf w\\cdot\\mathbf x + b), \\qquad \\text{margin} = \\frac{2}{\\lVert \\mathbf w\\rVert}","where":[]},{"t":"\\min_{\\mathbf w, b}\\; \\tfrac12 \\lVert \\mathbf w\\rVert^2 \\;\\text{ s.t. }\\; y_i(\\mathbf w\\cdot\\mathbf x_i + b) \\ge 1","where":[]},{"t":"K(\\mathbf x,\\mathbf z) = (\\mathbf x\\cdot\\mathbf z + 1)^p \\qquad K(\\mathbf x,\\mathbf z) = \\exp\\!\\left(-\\frac{\\lVert\\mathbf x - \\mathbf z\\rVert^2}{2\\sigma^2}\\right)","where":[]}]},{"topic":"mdp","card":"mdp-meu","title":"Utility and maximum expected utility","tex":[{"t":"EU(a \\mid s) = \\sum_{s'} P(s' \\mid s, a)\\, U(s'), \\qquad a^* = \\arg\\max_a EU(a \\mid s)","where":[["P(s' \\mid s,a)","probability that action a in s leads to s′"],["U(s')","utility (desirability) of s′"]]},{"t":"P(X_t \\mid X_{0:t-1}) = P(X_t \\mid X_{t-1})","where":[]}]},{"topic":"mdp","card":"mdp-def","title":"What an MDP is","tex":[{"t":"\\text{MDP} = \\big(S,\\; \\text{ACTIONS}(s),\\; P(s' \\mid s,a),\\; R(s,a,s')\\big)","where":[]}]},{"topic":"mdp","card":"mdp-utility","title":"Discounted reward and utility of a policy","tex":[{"t":"G_t = R_{t+1} + \\gamma R_{t+2} + \\gamma^2 R_{t+3} + \\cdots = \\sum_{k=0}^{\\infty}\\gamma^k R_{t+k+1}","where":[["\\gamma","discount factor, 0 ≤ γ < 1 (γ = 1: additive reward)"]]},{"t":"U^\\pi(s) = E\\left[\\sum_{t=0}^{\\infty}\\gamma^t R(S_t, \\pi(S_t), S_{t+1})\\right]","where":[]}]},{"topic":"mdp","card":"mdp-bellman","title":"Bellman equation and Q-values","tex":[{"t":"U(s) = \\max_{a} \\sum_{s'} P(s' \\mid s, a)\\,\\big[R(s,a,s') + \\gamma\\, U(s')\\big]","where":[]},{"t":"Q(s,a) = \\sum_{s'} P(s' \\mid s, a)\\,\\big[R(s,a,s') + \\gamma \\max_{a'} Q(s',a')\\big]","where":[]},{"t":"U(s) = \\max_a Q(s,a), \\qquad \\pi^*(s) = \\arg\\max_a Q(s,a)","where":[]}]},{"topic":"mdp","card":"mdp-vi-pi","title":"Value iteration vs policy iteration","tex":[{"t":"U_{i+1}(s) \\leftarrow \\max_a \\sum_{s'} P(s' \\mid s,a)\\big[R(s,a,s') + \\gamma U_i(s')\\big]","where":[]},{"t":"\\text{stop when } \\delta \\le \\epsilon(1-\\gamma)/\\gamma","where":[]},{"t":"U_i(s) = \\sum_{s'} P(s' \\mid s, \\pi_i(s))\\big[R + \\gamma U_i(s')\\big], \\quad \\pi_{i+1}(s) = \\arg\\max_a \\sum_{s'} P(s'|s,a)\\big[R + \\gamma U_i(s')\\big]","where":[]}]},{"topic":"mdp","card":"mdp-rl","title":"Reinforcement learning family","tex":[{"t":"\\text{reward-to-go}(0,0) = (-0.04)\\times 4 + 1 = 0.84","where":[]},{"t":"\\hat P(s' \\mid s,a) = \\frac{N(s,a \\to s')}{N(s,a)}","where":[["N","observed counts"]]},{"t":"U^\\pi(s) \\leftarrow U^\\pi(s) + \\alpha\\big[R + \\gamma U^\\pi(s') - U^\\pi(s)\\big]","where":[["\\alpha","learning rate"]]}]},{"topic":"mdp","card":"mdp-qlearning","title":"Q-learning","tex":[{"t":"Q(s,a) \\leftarrow Q(s,a) + \\alpha\\big[R(s,a,s') + \\gamma \\max_{a'} Q(s',a') - Q(s,a)\\big]","where":[]},{"t":"f(u, n) = \\begin{cases} R^+ & n < N_e \\\\ u & \\text{otherwise}\\end{cases}","where":[]}]},{"topic":"bayes","card":"bayes-rules","title":"Probability toolkit","tex":[{"t":"P(\\neg A) = 1 - P(A),\\quad P(A\\cup B) = P(A) + P(B),\\quad P(A \\cap B) = P(A)P(B),\\quad P(A \\mid B) = \\frac{P(A\\cap B)}{P(B)}","where":[]}]},{"topic":"bayes","card":"bayes-joint-table","title":"Full joint probability table","tex":[{"t":"P(X = x) = \\sum_y \\sum_z P(X = x, Y = y, Z = z)","where":[]},{"t":"P(\\text{event}_j) = \\frac{\\text{occurrences of event}_j}{\\text{total experiments}}","where":[]}]},{"topic":"bayes","card":"bayes-bn","title":"Bayesian networks","tex":[{"t":"P(x_1,\\dots,x_n) = \\prod_{i=1}^{n} P\\big(x_i \\mid \\text{Parents}(X_i)\\big)","where":[]},{"t":"P(B,E,A,J,M) = P(B)\\,P(E)\\,P(A \\mid B,E)\\,P(J \\mid A)\\,P(M \\mid A)","where":[]}]},{"topic":"bayes","card":"bayes-rule","title":"Bayes' rule: causal vs diagnostic","tex":[{"t":"P(D \\mid S) = \\frac{P(S \\mid D)\\,P(D)}{P(S)}, \\qquad P(S) = P(S\\mid D)P(D) + P(S \\mid \\neg D)P(\\neg D)","where":[["P(D)","prior"],["P(S\\mid D)","likelihood"],["P(D\\mid S)","posterior"]]},{"t":"P(Y \\mid X) = \\alpha\\, P(X \\mid Y)\\, P(Y)","where":[["\\alpha","normalisation constant (makes the posterior sum to 1)"]]},{"t":"\\text{Conditional independence: } P(X, Y \\mid Z) = P(X \\mid Z)\\,P(Y \\mid Z)","where":[]}]},{"topic":"bayes","card":"bayes-enumeration","title":"Exact inference by enumeration","tex":[{"t":"P(B \\mid j, m) = \\alpha\\, P(B)\\sum_{e} P(e)\\sum_{a} P(a \\mid B, e)\\, P(j \\mid a)\\, P(m \\mid a)","where":[]},{"t":"P(b \\mid j,m) = \\frac{s_B}{s_B + s_{\\neg B}} = \\frac{0.00059224}{0.00059224 + 0.00149186} \\approx 0.2842","where":[]}]},{"topic":"cnn","card":"cnn-basics","title":"How computers see","tex":[{"t":"\\text{image tensor} \\in \\mathbb R^{C \\times H \\times W}, \\quad \\text{grayscale } C = 1,\\; \\text{RGB } C = 3","where":[]}]},{"topic":"cnn","card":"cnn-why","title":"Why convolution (not dense layers)?","tex":[{"t":"224 \\times 224 \\times 3 = 150{,}528 \\text{ inputs};\\; 150{,}528 \\times 1000 = 150{,}528{,}000 \\text{ weights}","where":[]}]},{"topic":"cnn","card":"cnn-conv","title":"The convolution operation","tex":[{"t":"z[p,q] = \\sum_{i}\\sum_{j} w_{ij}\\, x[p+i,\\, q+j] + b","where":[["w_{ij}","kernel weights"],["b","bias (one per filter)"]]},{"t":"N_{\\text{out}} = \\left\\lfloor \\frac{N_{\\text{in}} + 2P - K}{S} \\right\\rfloor + 1","where":[["N_{\\text{in}}","input width"],["P","padding"],["K","kernel size"],["S","stride"]]}]},{"topic":"cnn","card":"cnn-params","title":"Filters, channels and parameter counts","tex":[{"t":"\\#\\text{params} = (K_h \\cdot K_w \\cdot C_{\\text{in}} + 1)\\cdot C_{\\text{out}}","where":[["C_{\\text{in}}","input channels"],["C_{\\text{out}}","number of filters"]]},{"t":"(3\\cdot3\\cdot3 + 1)\\cdot 2 = 56","where":[]}]},{"topic":"cnn","card":"cnn-pool","title":"ReLU and pooling","tex":[{"t":"\\text{ReLU}(z) = \\max(0, z), \\qquad \\text{LeakyReLU}(z) = \\max(\\alpha z, z),\\; \\alpha = 0.1","where":[]},{"t":"\\max(230, 135, 231, 146) = 231","where":[]}]},{"topic":"cnn","card":"cnn-arch","title":"CNN classifiers, training & classic architectures","tex":[{"t":"y = \\text{ReLU}\\big(F(x) + x\\big)","where":[]},{"t":"1{\\times}28{\\times}28 \\to 16{\\times}14{\\times}14 \\to 16{\\times}7{\\times}7 \\to 32{\\times}7{\\times}7 \\to 32{\\times}3{\\times}3 \\to 288 \\to 10","where":[]}]},{"topic":"detect","card":"detect-task","title":"From classification to detection","tex":[{"t":"\\text{YOLO output} = S \\times S \\times (5 + C)","where":[["5","x, y, w, h, objectness"],["C","number of classes"]]}]},{"topic":"detect","card":"detect-iou","title":"Intersection over Union","tex":[{"t":"\\text{IoU} = \\frac{I}{A + B - I}, \\quad I = \\max\\!\\big(0, \\min(x_2^A,x_2^B) - \\max(x_1^A,x_1^B)\\big)\\cdot \\max\\!\\big(0, \\min(y_2^A,y_2^B)-\\max(y_1^A,y_1^B)\\big)","where":[]},{"t":"\\frac{16}{24 + 24 - 16} = \\frac{16}{32} = 0.5","where":[]}]},{"topic":"detect","card":"detect-seg","title":"Semantic segmentation","tex":[{"t":"[N, C, H, W] \\xrightarrow{\\arg\\max_C} [N, H, W]","where":[]}]},{"topic":"seq","card":"seq-intro","title":"Why sequences need memory","tex":[{"t":"h_t = f(x_t, h_{t-1}), \\qquad \\hat y_t = g(h_t)","where":[]}]},{"topic":"seq","card":"seq-rnn","title":"The RNN hidden-state update","tex":[{"t":"h_t = \\tanh\\big(W_{hh}^{\\top} h_{t-1} + W_{xh}^{\\top} x_t\\big), \\qquad \\hat y_t = W_{hy}^{\\top} h_t","where":[]},{"t":"0.5\\times 2 + 0.25 \\times 0.4 = 1.1 \\;\\Rightarrow\\; h_t = \\tanh(1.1) = 0.800","where":[]}]},{"topic":"seq","card":"seq-gradients","title":"Training RNNs: BPTT and vanishing gradients","tex":[{"t":"\\frac{\\partial L_t}{\\partial h_1} = \\frac{\\partial L_t}{\\partial h_t}\\prod_{k=2}^{t}\\frac{\\partial h_k}{\\partial h_{k-1}} = \\frac{\\partial L_t}{\\partial h_t}\\, D_t W_{hh} D_{t-1} W_{hh}\\cdots D_2 W_{hh}","where":[]},{"t":"h_t = g_t \\odot \\tilde h_t","where":[]}]},{"topic":"seq","card":"seq-nb","title":"Naive Bayes sentiment","tex":[{"t":"P(c \\mid \\text{text}) \\propto P(c)\\prod_i P(x_i \\mid c)","where":[]},{"t":"P_s(w \\mid c) = \\frac{\\text{count}(w, c) + 1}{T_c + |V|}","where":[["T_c","total word occurrences in class c"],["|V|","vocabulary size"]]},{"t":"S_+ = 0.55\\times0.27\\times0.23\\times0.12\\times0.08 = 0.000328","where":[]}]},{"topic":"seq","card":"seq-ngram","title":"N-grams and Word2Vec","tex":[{"t":"P(w \\mid h) = \\frac{C(h, w)}{C(h)}, \\qquad P(\\text{Grogu} \\mid \\text{Mando protects}) = \\frac{3}{5}","where":[]},{"t":"s = W_{\\text{out}}\\, h,\\quad p = \\text{softmax}(s),\\quad L = -\\log p_{\\text{target}}","where":[]}]},{"topic":"attn","card":"attn-calc","title":"Scores → softmax → weighted sum","tex":[{"t":"\\text{score}_i = \\frac{\\mathbf q\\cdot \\mathbf k_i}{\\sqrt{d_k}}, \\qquad w_i = \\frac{e^{\\text{score}_i}}{\\sum_j e^{\\text{score}_j}}, \\qquad \\mathbf z = \\sum_i w_i\\, \\mathbf v_i","where":[]},{"t":"[0.3, 0.7] \\text{ with } [2,0],[0,2] \\Rightarrow [0.3\\cdot2 + 0.7\\cdot 0,\\; 0.3\\cdot 0 + 0.7\\cdot 2] = [0.6, 1.4]","where":[]}]},{"topic":"attn","card":"attn-matrix","title":"Self-attention in matrix form","tex":[{"t":"Q = XW_Q,\\; K = XW_K,\\; V = XW_V, \\qquad \\text{Attention}(Q,K,V) = \\text{softmax}\\!\\left(\\frac{QK^{\\top}}{\\sqrt{d_k}}\\right)V","where":[]},{"t":"PE(pos, 2i) = \\sin\\!\\left(\\frac{pos}{10000^{2i/d_{\\text{model}}}}\\right), \\quad PE(pos, 2i+1) = \\cos\\!\\left(\\frac{pos}{10000^{2i/d_{\\text{model}}}}\\right)","where":[]},{"t":"\\text{MultiHead}(Q,K,V) = \\text{Concat}(\\text{head}_1,\\dots,\\text{head}_h)\\,W^O","where":[]}]},{"topic":"nn","card":"nn-structure","title":"Neurons and networks","tex":[{"t":"in_j = \\sum_{i} w_{i,j}\\, a_i \\;(+\\, w_{0,j}), \\qquad a_j = g(in_j)","where":[["a_i","activation coming from unit i"],["w_{i,j}","weight on the link i → j"],["g","activation function"]]},{"t":"\\text{ReLU}(x) = \\max(0,x)\\quad \\sigma(z) = \\frac{1}{1+e^{-z}}\\quad \\tanh(x) = \\frac{e^{2x}-1}{e^{2x}+1}\\quad \\text{softplus}(x) = \\ln(1+e^x)","where":[]},{"t":"\\#\\text{params of a dense layer} = (\\#\\text{inputs} + 1)\\times \\#\\text{units}","where":[]}]},{"topic":"nn","card":"nn-perceptron","title":"Perceptron and its learning rule","tex":[{"t":"ws = \\sum_{j=0}^{n} w_j x_j \\;(x_0 = 1), \\qquad h_w(\\mathbf x) = \\begin{cases}1 & ws \\ge 0\\\\ 0 & ws < 0\\end{cases}","where":[]},{"t":"w_i \\leftarrow w_i + \\alpha\\,\\big(y - h_w(\\mathbf x)\\big)\\,x_i","where":[["\\alpha","learning rate"],["y - h_w(\\mathbf x)","error: +1, 0 or −1"]]}]},{"topic":"nn","card":"nn-backprop","title":"Gradient descent and backpropagation","tex":[{"t":"\\text{Loss} = (y - \\hat y)^2, \\qquad \\Delta_5 = 2(\\hat y - y)\\, g'(in_5)","where":[]},{"t":"\\Delta_i = g'(in_i)\\, w_{i,j}\\, \\Delta_j","where":[]},{"t":"\\frac{\\partial L}{\\partial w_{i,j}} = a_i\\,\\Delta_j, \\qquad w_{i,j} \\leftarrow w_{i,j} - \\alpha\\, a_i\\,\\Delta_j","where":[]},{"t":"\\text{sigmoid unit: } w_i \\leftarrow w_i + \\alpha\\,(y - h)\\,h(1-h)\\,x_i","where":[]}]},{"topic":"nn","card":"nn-lstm","title":"RNNs and LSTMs (Workshop 5)","tex":[{"t":"z_t = g_z(W_{zz} z_{t-1} + W_{xz} x_t), \\qquad \\hat y_t = g_y(W_{zy} z_t)","where":[]},{"t":"f_t = \\sigma(W_{xf}x_t + W_{zf}z_{t-1}),\\; i_t = \\sigma(W_{xi}x_t + W_{zi}z_{t-1}),\\; o_t = \\sigma(W_{xo}x_t + W_{zo}z_{t-1})","where":[]},{"t":"c_t = c_{t-1}\\odot f_t + i_t \\odot \\tanh(W_{xc}x_t + W_{zc}z_{t-1}), \\qquad z_t = \\tanh(c_t)\\odot o_t","where":[["\\odot","element-wise multiplication"]]}]},{"topic":"local","card":"local-problem","title":"Local search & optimisation problems","tex":[{"t":"f = \\min\\,\\text{cost}(x_1,\\dots,x_n) \\quad\\text{or}\\quad f = \\max\\,\\text{fit}(x_1,\\dots,x_n)","where":[["x_i","decision variables (e.g. queen positions)"],["\\text{low}_i \\le x_i \\le \\text{high}_i","constraints on each variable"]]}]},{"topic":"local","card":"local-hc","title":"Hill climbing","tex":[{"t":"\\text{if } \\text{VALUE}(\\text{best neighbour}) \\le \\text{VALUE}(\\text{current}) \\text{ then stop}","where":[]}]},{"topic":"local","card":"local-sa","title":"Simulated annealing","tex":[{"t":"p(\\text{accept worse move}) = e^{-\\Delta/T}","where":[["\\Delta","how much worse the neighbour is (energy increase)"],["T","current temperature from the cooling schedule"]]},{"t":"\\Delta=2,\\;T=5:\\; p = e^{-0.4} \\approx 0.670","where":[]}]},{"topic":"local","card":"local-ga","title":"Genetic algorithms","tex":[{"t":"P(i) = \\frac{f_i}{\\sum_j f_j}","where":[["f_i","fitness of individual i"]]},{"t":"P(x_1) = \\frac{24}{24+23+20+11} = \\frac{24}{78} \\approx 0.31","where":[]}]},{"topic":"genai","card":"genai-intro","title":"What generative modelling is","tex":[{"t":"\\text{training data} \\sim P_{\\text{data}}(x), \\quad \\text{learn } P_{\\text{model}}(x) \\approx P_{\\text{data}}(x)","where":[]}]},{"topic":"genai","card":"genai-ae","title":"Autoencoders and VAEs","tex":[{"t":"\\mathcal L(x, \\hat x) = \\lVert x - \\hat x\\rVert^2","where":[]},{"t":"\\mathcal L(\\phi,\\theta,x) = \\text{reconstruction} + D_{KL}\\big(q_\\phi(z \\mid x)\\,\\Vert\\, p(z)\\big), \\quad D_{KL} = \\tfrac12\\sum_j\\big(\\mu_j^2 + \\sigma_j^2 - 1 - \\log\\sigma_j^2\\big)","where":[]},{"t":"z = \\mu + \\sigma\\odot\\varepsilon,\\quad \\varepsilon\\sim\\mathcal N(0, I)","where":[]}]},{"topic":"genai","card":"genai-gan","title":"GANs","tex":[{"t":"\\min_G \\max_D\\; \\mathbb E_{x\\sim p_{\\text{data}}}\\big[\\log D(x)\\big] + \\mathbb E_{z\\sim p(z)}\\big[\\log\\big(1 - D(G(z))\\big)\\big]","where":[]}]},{"topic":"genai","card":"genai-ar-diff","title":"Autoregressive and diffusion models","tex":[{"t":"p(x_1,\\dots,x_n) = \\prod_i p(x_i \\mid x_1,\\dots,x_{i-1}), \\qquad \\hat x_i = \\sigma\\Big(b_i + \\sum_{j<i} w_{ij}x_j\\Big)","where":[]},{"t":"x_t = \\sqrt{\\bar\\alpha_t}\\,x_0 + \\sqrt{1-\\bar\\alpha_t}\\,\\epsilon, \\qquad \\mathcal L_{\\text{MSE}} = \\lVert \\hat\\epsilon - \\epsilon\\rVert^2","where":[]}]},{"topic":"logic","card":"logic-pl","title":"Propositional logic: syntax and semantics","tex":[{"t":"P \\Rightarrow Q \\;\\equiv\\; \\neg P \\vee Q, \\qquad P \\Leftrightarrow Q \\;\\equiv\\; (P\\Rightarrow Q)\\wedge(Q \\Rightarrow P)","where":[]},{"t":"\\neg P \\vee Q \\wedge R \\Rightarrow S \\;=\\; \\big((\\neg P) \\vee (Q \\wedge R)\\big) \\Rightarrow S","where":[]}]},{"topic":"logic","card":"logic-equivalence","title":"Logical equivalences","tex":[{"t":"\\neg(\\alpha\\wedge\\beta) \\equiv \\neg\\alpha \\vee \\neg\\beta \\qquad \\neg(\\alpha\\vee\\beta) \\equiv \\neg\\alpha\\wedge\\neg\\beta","where":[]},{"t":"\\alpha \\Rightarrow \\beta \\equiv \\neg\\beta \\Rightarrow \\neg\\alpha \\qquad \\alpha\\vee(\\beta\\wedge\\gamma) \\equiv (\\alpha\\vee\\beta)\\wedge(\\alpha\\vee\\gamma)","where":[]}]},{"topic":"logic","card":"logic-fol","title":"First-order logic","tex":[{"t":"\\forall x\\; \\text{Student}(x) \\Rightarrow \\text{Studies}(x) \\qquad \\exists x\\; \\text{Student}(x) \\wedge \\text{Enrolled}(x, AI)","where":[]},{"t":"\\forall x\\, \\neg P(x) \\;\\Leftrightarrow\\; \\neg \\exists x\\, P(x)","where":[]},{"t":"\\text{UI: } \\forall v\\,\\alpha \\vdash \\text{Subst}(\\{v/g\\}, \\alpha) \\qquad \\text{EI: } \\exists v\\,\\alpha \\vdash \\text{Subst}(\\{v/k\\}, \\alpha),\\; k \\text{ new}","where":[]}]},{"topic":"logic","card":"logic-inference","title":"Inference: model checking, theorem proving, resolution","tex":[{"t":"\\alpha \\models \\beta \\iff M(\\alpha) \\subseteq M(\\beta)","where":[["M(\\alpha)","set of models in which α is true"]]},{"t":"\\frac{\\alpha\\Rightarrow\\beta,\\quad \\alpha}{\\beta}\\;(\\text{Modus Ponens}) \\qquad \\frac{\\ell_1 \\vee \\dots \\vee \\ell_k,\\quad m_1\\vee\\dots\\vee m_n}{\\text{all literals except the complementary pair}}","where":[]},{"t":"\\alpha \\models \\beta \\iff \\alpha \\wedge \\neg\\beta \\text{ is unsatisfiable}","where":[]}]},{"topic":"kr","card":"kr-hierarchy","title":"Hierarchies and categories","tex":[{"t":"\\text{Basketball} \\in \\text{SportsBalls}, \\qquad \\text{Basketballs} \\subseteq \\text{SportsBalls}","where":[]}]},{"topic":"kr","card":"kr-ontology","title":"Ontologies and knowledge graphs","tex":[{"t":"\\text{Student} \\sqsubseteq \\text{Person},\\; \\text{Student}(Alice) \\Rightarrow \\text{Person}(Alice)","where":[]},{"t":"\\text{enrolsIn}(s,c)\\wedge\\text{includes}(c,u)\\wedge\\text{ownedBy}(u,d) \\Rightarrow \\text{studiesInDepartment}(s,d)","where":[]}]}]