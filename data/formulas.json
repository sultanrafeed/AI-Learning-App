[{"name":"Uniform-cost search","f":"f(n) = g(n)","note":"g(n) = path cost from the start to n","topic":"search"},{"name":"Greedy best-first","f":"f(n) = h(n)","note":"h(n) = estimated cost from n to the goal","topic":"search"},{"name":"A*","f":"f(n) = g(n) + h(n)","note":"estimated cost of the cheapest solution through n","topic":"search"},{"name":"Admissible","f":"h(n) ≤ h*(n) for all n","note":"never overestimates","topic":"search"},{"name":"Consistent","f":"h(n) ≤ c(n, a, n′) + h(n′)","note":"triangle inequality on every edge","topic":"search"},{"name":"Entropy","f":"H(S) = − Σᵢ pᵢ log₂ pᵢ","note":"binary: B(q) = −[q log₂ q + (1−q) log₂(1−q)]","topic":"trees"},{"name":"Information gain","f":"IG(A) = H(parent) − Σᵥ (|Sᵥ|/|S|)·H(Sᵥ)","note":"choose the highest","topic":"trees"},{"name":"Gini index","f":"Gini(S) = 1 − Σᵢ pᵢ²","note":"binary max 0.5, pure 0","topic":"trees"},{"name":"Weighted child Gini","f":"Σᵢ (|Subsetᵢ|/|parent|)·Gini(Subsetᵢ)","note":"choose the lowest","topic":"trees"},{"name":"Gini reduction","f":"Gini(parent) − weighted child Gini","note":"choose the highest","topic":"trees"},{"name":"MSE","f":"(1/n) Σ (y − ŷ)²","note":"punishes large errors","topic":"ml"},{"name":"MAE","f":"(1/n) Σ |y − ŷ|","note":"robust, same units","topic":"ml"},{"name":"RMSE","f":"√MSE","note":"same units as y","topic":"ml"},{"name":"R²","f":"1 − Σ(y − ŷ)² / Σ(y − ȳ)²","note":"1 perfect, < 0 worse than mean","topic":"ml"},{"name":"MAPE","f":"(100/n) Σ |(y − ŷ)/y|","note":"fails when y ≈ 0","topic":"ml"},{"name":"Binary cross-entropy","f":"−[y ln p + (1 − y) ln(1 − p)]","note":"logistic regression loss","topic":"ml"},{"name":"Gradient descent","f":"w ← w − α ∂L/∂w","note":"α = learning rate","topic":"ml"},{"name":"Linear regression update","f":"w₀ ← w₀ + α(y − h); w₁ ← w₁ + α(y − h)x","note":"per example","topic":"ml"},{"name":"Precision / Recall","f":"TP/(TP+FP) ; TP/(TP+FN)","note":"F1 = 2PR/(P+R)","topic":"ml"},{"name":"SVM margin","f":"2/‖w‖ ; f(x) = sign(w·x + b)","note":"min ½‖w‖² s.t. yᵢ(w·xᵢ + b) ≥ 1","topic":"ml"},{"name":"Discounted return","f":"G = R₁ + γR₂ + γ²R₃ + … = Σ γᵏ Rₖ₊₁","note":"0 ≤ γ < 1 (γ = 1 → additive)","topic":"mdp"},{"name":"Expected utility","f":"EU(a|s) = Σₛ′ P(s′|s,a) U(s′)","note":"MEU: choose argmax","topic":"mdp"},{"name":"Bellman equation","f":"U(s) = maxₐ Σₛ′ P(s′|s,a)[R(s,a,s′) + γU(s′)]","note":"one equation per state","topic":"mdp"},{"name":"Q-function","f":"Q(s,a) = Σₛ′ P(s′|s,a)[R(s,a,s′) + γ maxₐ′ Q(s′,a′)]","note":"U(s) = maxₐ Q(s,a); π*(s) = argmaxₐ Q(s,a)","topic":"mdp"},{"name":"Policy evaluation","f":"Uᵢ(s) = Σₛ′ P(s′|s,πᵢ(s))[R + γUᵢ(s′)]","note":"no max: action fixed","topic":"mdp"},{"name":"TD update","f":"U(s) ← U(s) + α[R + γU(s′) − U(s)]","note":"passive, model-free","topic":"mdp"},{"name":"Q-learning","f":"Q(s,a) ← Q(s,a) + α[R + γ maxₐ′ Q(s′,a′) − Q(s,a)]","note":"active, model-free","topic":"mdp"},{"name":"Exploration function","f":"f(u, n) = R⁺ if n < Nₑ else u","note":"optimism for rarely tried actions","topic":"mdp"},{"name":"Conditional probability","f":"P(A|B) = P(A ∩ B)/P(B)","note":"GIVEN","topic":"bayes"},{"name":"Complement","f":"P(¬A) = 1 − P(A)","note":"NOT","topic":"bayes"},{"name":"Addition (mutually exclusive)","f":"P(A ∪ B) = P(A) + P(B)","note":"OR","topic":"bayes"},{"name":"Multiplication (independent)","f":"P(A ∩ B) = P(A)P(B)","note":"AND","topic":"bayes"},{"name":"Bayes' rule","f":"P(b|a) = P(a|b)P(b)/P(a)","note":"posterior = likelihood × prior ÷ evidence","topic":"bayes"},{"name":"General Bayes","f":"P(Y|X) = α P(X|Y)P(Y)","note":"α normalises","topic":"bayes"},{"name":"Conditional independence","f":"P(X,Y|Z) = P(X|Z)P(Y|Z) ⇔ P(X|Y,Z) = P(X|Z)","note":"","topic":"bayes"},{"name":"BN factorisation","f":"P(x₁,…,xₙ) = Πᵢ P(xᵢ | Parents(Xᵢ))","note":"","topic":"bayes"},{"name":"Marginalisation","f":"P(X = x) = Σᵧ Σ_z P(x, y, z)","note":"sum out","topic":"bayes"},{"name":"Enumeration","f":"P(B|j,m) = α P(B) Σₑ P(e) Σₐ P(a|B,e)P(j|a)P(m|a)","note":"then normalise","topic":"bayes"},{"name":"From experiments","f":"P(eventⱼ) = occurrences(eventⱼ)/total experiments","note":"","topic":"bayes"},{"name":"Conv output size","f":"N_out = ⌊(N_in + 2P − K)/S⌋ + 1","note":"floor before +1","topic":"cnn"},{"name":"Conv parameters","f":"(K_h·K_w·C_in + 1)·C_out","note":"+1 = one bias per filter","topic":"cnn"},{"name":"Conv layer output","f":"z[p,q] = Σᵢ Σⱼ wᵢⱼ·x[p+i, q+j] + b","note":"no kernel flip","topic":"cnn"},{"name":"ReLU / Leaky ReLU","f":"max(0, x) ; max(αx, x), α = 0.1","note":"","topic":"cnn"},{"name":"Receptive field (Extra)","f":"RF_l = RF_(l−1) + (K_l − 1)·Π strides of earlier layers","note":"RF₀ = 1","topic":"cnn"},{"name":"ResNet block","f":"y = ReLU(F(x) + x)","note":"skip connection","topic":"cnn"},{"name":"IoU","f":"IoU = I / (A + B − I)","note":"I = intersection area","topic":"detect"},{"name":"Intersection width","f":"min(x₂ᴬ, x₂ᴮ) − max(x₁ᴬ, x₁ᴮ) (0 if negative)","note":"same for height","topic":"detect"},{"name":"YOLO output","f":"S × S × (5 + C)","note":"x, y, w, h, objectness + C class scores","topic":"detect"},{"name":"RNN update","f":"hₜ = tanh(W_hh hₜ₋₁ + W_xh xₜ (+ b))","note":"ŷₜ = W_hy hₜ","topic":"seq"},{"name":"BPTT gradient","f":"∂Lₜ/∂h₁ = ∂Lₜ/∂hₜ · Π ∂hₖ/∂hₖ₋₁ = … D_kW_hh …","note":"repeated products","topic":"seq"},{"name":"Gate","f":"hₜ = gₜ ⊙ h̃ₜ, gₜ = σ(W_g · + b_g)","note":"element-wise","topic":"seq"},{"name":"Naive Bayes","f":"P(c|text) ∝ P(c) Πᵢ P(xᵢ|c)","note":"normalise with Z = S₊ + S₋","topic":"seq"},{"name":"Add-one smoothing","f":"P(w|c) = (count + 1)/(T_c + |V|)","note":"","topic":"seq"},{"name":"N-gram","f":"P(w|h) = C(h, w)/C(h)","note":"trigram: h = last 2 words","topic":"seq"},{"name":"CBOW / skip-gram","f":"s = W_out h; p = softmax(s); L = −log p_target","note":"","topic":"seq"},{"name":"Score","f":"scoreᵢ = q · kᵢ / √d_k","note":"scaled dot product","topic":"attn"},{"name":"Softmax","f":"wᵢ = e^{scoreᵢ} / Σⱼ e^{scoreⱼ}","note":"weights sum to 1","topic":"attn"},{"name":"Output","f":"z = Σᵢ wᵢ vᵢ","note":"same length as each value","topic":"attn"},{"name":"Self-attention","f":"Attention(Q, K, V) = softmax(QKᵀ/√d_k) V","note":"Q = XW_Q, K = XW_K, V = XW_V","topic":"attn"},{"name":"Multi-head","f":"MultiHead(Q,K,V) = Concat(head₁,…,head_h) W^O","note":"","topic":"attn"},{"name":"Positional encoding","f":"PE(pos,2i) = sin(pos/10000^{2i/d}), PE(pos,2i+1) = cos(…)","note":"","topic":"attn"},{"name":"Unit","f":"inⱼ = Σᵢ wᵢⱼ aᵢ ; aⱼ = g(inⱼ)","note":"bias = weight w₀ⱼ on constant input 1","topic":"nn"},{"name":"Perceptron rule","f":"wᵢ ← wᵢ + α(y − h_w(x))·xᵢ","note":"hard threshold","topic":"nn"},{"name":"Sigmoid GD rule","f":"wᵢ ← wᵢ + α(y − h)·h(1 − h)·xᵢ","note":"σ′ = σ(1 − σ)","topic":"nn"},{"name":"Output perceived error","f":"Δ₅ = 2(ŷ − y)·g′(in₅)","note":"squared loss","topic":"nn"},{"name":"Hidden perceived error","f":"Δᵢ = g′(inᵢ)·wᵢⱼ·Δⱼ","note":"backpropagated","topic":"nn"},{"name":"Weight gradient","f":"∂L/∂wᵢⱼ = aᵢ·Δⱼ ; wᵢⱼ ← wᵢⱼ − α·aᵢ·Δⱼ","note":"","topic":"nn"},{"name":"LSTM cell","f":"cₜ = cₜ₋₁ ⊙ fₜ + iₜ ⊙ tanh(W_xc xₜ + W_zc zₜ₋₁); zₜ = tanh(cₜ) ⊙ oₜ","note":"f, i, o = σ(…)","topic":"nn"},{"name":"SA acceptance","f":"p = exp(−Δ/T)","note":"better moves always accepted","topic":"local"},{"name":"Roulette probability","f":"P(i) = fᵢ / Σⱼ fⱼ","note":"24/78 = 0.31","topic":"local"},{"name":"Objective","f":"f = min(cost) or f = max(fit)","note":"cost = Q(x₁, …, xₙ)","topic":"local"},{"name":"8-queens successors","f":"8 × 7 = 56","note":"move one queen within its column","topic":"local"},{"name":"AE loss","f":"L(x, x̂) = ‖x − x̂‖²","note":"no labels","topic":"genai"},{"name":"VAE loss","f":"L = reconstruction loss + D_KL(q_φ(z|x) ‖ p(z))","note":"p(z) = N(0, I)","topic":"genai"},{"name":"KL to N(0,1)","f":"½ Σⱼ (μⱼ² + σⱼ² − 1 − log σⱼ²)","note":"0 when μ = 0, σ = 1","topic":"genai"},{"name":"Reparameterisation","f":"z = μ + σ ⊙ ε, ε ~ N(0, I)","note":"backprop through μ, σ","topic":"genai"},{"name":"β-VAE","f":"−E[log p_θ(x|z)] + β D_KL","note":"β > 1 → disentanglement","topic":"genai"},{"name":"GAN objective","f":"min_G max_D E_x[log D(x)] + E_z[log(1 − D(G(z)))]","note":"","topic":"genai"},{"name":"Autoregressive","f":"p(x₁…xₙ) = Πᵢ p(xᵢ | x₁…xᵢ₋₁)","note":"FVSBN x̂ᵢ = σ(bᵢ + Σⱼ<ᵢ wᵢⱼxⱼ)","topic":"genai"},{"name":"Diffusion forward","f":"xₜ = √ᾱₜ x₀ + √(1 − ᾱₜ) ε","note":"train: ‖ε̂ − ε‖²","topic":"genai"},{"name":"Implication elimination","f":"α ⇒ β ≡ ¬α ∨ β","note":"","topic":"logic"},{"name":"Biconditional elimination","f":"α ⇔ β ≡ (α ⇒ β) ∧ (β ⇒ α)","note":"","topic":"logic"},{"name":"Contraposition","f":"α ⇒ β ≡ ¬β ⇒ ¬α","note":"","topic":"logic"},{"name":"De Morgan","f":"¬(α ∧ β) ≡ ¬α ∨ ¬β ; ¬(α ∨ β) ≡ ¬α ∧ ¬β","note":"","topic":"logic"},{"name":"Quantifier De Morgan","f":"∀x ¬P ⇔ ¬∃x P","note":"","topic":"logic"},{"name":"Entailment","f":"α ⊨ β ⇔ M(α) ⊆ M(β)","note":"","topic":"logic"},{"name":"Modus Ponens","f":"α ⇒ β, α ⊢ β","note":"","topic":"logic"},{"name":"And-elimination","f":"α ∧ β ⊢ α","note":"","topic":"logic"},{"name":"Resolution","f":"(ℓ₁ ∨ … ∨ ℓₖ), (m₁ ∨ … ∨ mₙ) ⊢ all literals except the complementary pair","note":"","topic":"logic"},{"name":"Refutation","f":"α ⊨ β ⇔ α ∧ ¬β is unsatisfiable","note":"derive □","topic":"logic"},{"name":"Universal Instantiation","f":"∀v α ⊢ Subst({v/g}, α)","note":"any ground term g","topic":"logic"},{"name":"Existential Instantiation","f":"∃v α ⊢ Subst({v/k}, α)","note":"k a NEW constant","topic":"logic"},{"name":"Membership","f":"object ∈ Category","note":"Basketball ∈ SportsBalls","topic":"kr"},{"name":"Subset","f":"SubCategory ⊆ Category","note":"Basketballs ⊆ SportsBalls","topic":"kr"},{"name":"Class inference","f":"Student ⊑ Person ∧ Student(Alice) ⇒ Person(Alice)","note":"","topic":"kr"},{"name":"Property chain","f":"enrolsIn(s,c) ∧ includes(c,u) ∧ ownedBy(u,d) ⇒ studiesInDepartment(s,d)","note":"","topic":"kr"},{"name":"RDF triple","f":"subject — predicate → object","note":"","topic":"kr"},{"name":"SPARQL","f":"SELECT ?item WHERE { ?item w